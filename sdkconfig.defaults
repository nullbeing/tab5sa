# Tab5-SDR minimal defaults — derived from the proven Tab5-HID-Device config
# (same board/BSP), with the TinyUSB-device and LVGL bits dropped for Stage 1-2.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# This Tab5's ESP32-P4 is silicon revision v1.0 (an early batch). IDF v5.5
# defaults the bootloader to require rev >= v3.01, which refuses to flash.
# Pin the minimum revision to v1.0 so the image matches the real chip.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# PSRAM — the IQ ring buffer and waterfall history live here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MEMTEST=n

# Bluetooth: the Tab5 BSP unconditionally pulls in NimBLE/esp_hosted, so the
# controller must stay enabled even though the SDR app doesn't use BT.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# NOTE: leave CONFIG_FREERTOS_HZ at its default 100. Bumping it to 1000 was
# observed to stall the RTL-SDR stream (no IQ ever arrived, NO DATA on screen):
# components/librtlsdr/src/libusb.c calls vTaskDelay(1 / portTICK_PERIOD_MS),
# which integer-divides to 0 (a bare yield) at 100 Hz but to 1 tick — a real
# 1 ms sleep — at 1000 Hz, throttling USB event pumping. Fix that idiom first
# if a finer tick is ever needed.

# esp_hosted link to the on-board ESP32-C6 (Wi-Fi/BT coprocessor) over SDIO.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=13
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=12
CONFIG_ESP_HOSTED_SDIO_PIN_D0=11
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=10
CONFIG_ESP_HOSTED_SDIO_PIN_D2=9
CONFIG_ESP_HOSTED_SDIO_PIN_D3=8
CONFIG_ESP_HOSTED_ENABLE_BT_BLUEDROID=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y

# Don't halt on panic — reboot so a brownout/crash loop is visible from the host.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_LOG_COLORS=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
